{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "task-mailbox": {
      "type": "streamable-http",
      "url": "https://mcp.example.com/mailbox/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" }
          }
        }
      }
    }
  }
}
