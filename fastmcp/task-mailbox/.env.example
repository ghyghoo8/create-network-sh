# This file contains placeholders only. Install private values on the host.
TASK_MAILBOX_PUBLIC_BASE_URL=https://mcp.example.com/mailbox
TASK_MAILBOX_GITHUB_CLIENT_ID=REPLACE_DEDICATED_OAUTH_APP_ID
TASK_MAILBOX_GITHUB_CLIENT_SECRET=REPLACE_DEDICATED_OAUTH_APP_SECRET
TASK_MAILBOX_ALLOWED_GITHUB_USER=REPLACE_ALLOWED_ACCOUNT
# Generate once with secrets.token_urlsafe(48); keep stable across restarts.
TASK_MAILBOX_SIGNING_KEY=REPLACE_INDEPENDENT_RANDOM_SIGNING_KEY
TASK_MAILBOX_DATA_DIR=/var/lib/task-mailbox
FASTMCP_HOME=/var/lib/task-mailbox/oauth
TASK_MAILBOX_PORT=8766
TASK_MAILBOX_MAX_PAYLOAD_BYTES=1048576
TASK_MAILBOX_MAX_DATABASE_BYTES=268435456
TASK_MAILBOX_MAX_JOBS=10000
TASK_MAILBOX_MAX_OAUTH_BYTES=8388608
TASK_MAILBOX_MAX_OAUTH_FILES=512
